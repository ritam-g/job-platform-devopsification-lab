PORT=5003

# Database
MONGO_URI=your_notification_service_mongo_uri_here

# Internal service-to-service auth (must match api-gateway & chat-service)
INTERNAL_SECRET=your_shared_internal_secret_here

# Frontend (CORS config we saw in app.js)
FRONTEND_URL=http://localhost:5173

# RabbitMQ — only needed if notificationConsumer.js is still in use
RABBITMQ_URI=amqp://localhost:5672